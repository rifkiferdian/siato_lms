# Local environment and secrets (keep the documented example).
.env
.env.local
.env.*.local
!.env.example

# Go build and test artifacts.
/bin/
*.exe
*.test
*.out
/coverage/
/coverage.html

# Runtime and uploaded files. Directory placeholders stay versioned.
/storage/private/*
!/storage/private/.gitkeep
/storage/temp/*
!/storage/temp/.gitkeep

# Node dependencies and generated frontend assets.
/node_modules/
/web/static/css/app.css
/web/static/vendor/
/web/static/fonts/*.woff2

# Air and application runtime output.
/tmp/
*.log

# OS and editor noise.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
