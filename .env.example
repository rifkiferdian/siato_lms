APP_NAME=SIATO LMS
APP_ENV=development
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
TRUSTED_PROXIES=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=siato_lms
DB_USER=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Generate at least 64 random characters. Application refuses short secrets.
SESSION_SECRET=replace-with-at-least-64-random-characters-before-running-the-app
SESSION_MAX_AGE=28800
COOKIE_SECURE=false
STORAGE_PATH=./storage/private


